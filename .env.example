# Copy this file to .env (in this folder) and fill in your own values. Never commit .env.

# Portkey API key used for all model calls (https://portkey.ai)
PORTKEY_API_KEY=your-portkey-api-key-here

# Secret used to sign login session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-string

# Optional overrides (defaults shown)
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_REASONING_EFFORT=high
